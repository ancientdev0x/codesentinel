# --- Model provider credentials (set the one matching your CodeSentinel_MODEL) ---
# anthropic/<model>     e.g. anthropic/claude-sonnet-4-6
ANTHROPIC_API_KEY=
# openai/<model>        e.g. openai/gpt-5.5
OPENAI_API_KEY=
# openrouter/<model>
OPENROUTER_API_KEY=

# Cloudflare Workers AI: model 'cloudflare-workers-ai/@cf/meta/llama-3.3-70b-instruct-fp8-fast'
# CLOUDFLARE_API_KEY accepts a Cloudflare API token (or a `wrangler login` OAuth token) with AI access.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
# Only for model 'cloudflare-ai-gateway/<model>':
# CLOUDFLARE_GATEWAY_ID=

# --- CodeSentinel config (optional; defaults shown) ---
# CodeSentinel_MODEL=anthropic/claude-sonnet-4-6
# CodeSentinel_REVIEW_LANGUAGE=English
# CodeSentinel_THINKING_LEVEL=medium
# CodeSentinel_TELEMETRY=true   # set to false to opt out of anonymous usage telemetry

# --- CodeSentinel QA (CodeSentinel qa; see docs/ambient-qa.md) ---
# CodeSentinel_QA_MODEL=anthropic/claude-opus-4-8
# CodeSentinel_QA_TARGET=http://localhost:5173   # URL/path under test (E2E_BASE_URL)
# CodeSentinel_QA_SCOPE=login, checkout           # flows/areas to prioritize
# CodeSentinel_QA_THINKING_LEVEL=high
# CHROME_BIN=/usr/bin/chromium               # the Chrome/Chromium the agent drives over CDP

# --- pi-ai transient-retry tuning (in-process; applies to all model calls) ---
# PI_AI_RETRY_ATTEMPTS=4   # retries after the first try
# PI_AI_RETRY_BASE_MS=500  # exponential backoff base; delay_i = base*3^i (+jitter) → ~500,1500,4500,13500ms
# PI_AI_DISABLE_RETRY=1    # disable transient retries entirely

# --- GitHub (only when reviewing a PR with platform=github) ---
# GITHUB_TOKEN=

# --- Live "@CodeSentinel" channel (webhook server mode only; see docs/tag-CodeSentinel.md) ---
# GITHUB_WEBHOOK_SECRET=
